<?xml version="1.0" encoding="utf-8"?>
<!--
  디버그 빌드 전용 네트워크 설정.

  주의: 이 파일은 Janus 서버의 사설 CA 문제를 해결하지 못한다. network security
  config 는 Java/Kotlin 계층(OkHttp, HttpURLConnection, WebView)에만 적용되고,
  dart:io 소켓 — WebSocket.connect / web_socket_channel / janus_client 트랜스포트 —
  은 Flutter 에 내장된 자체 루트 CA 목록을 쓰기 때문에 여기 설정을 보지 않는다.
  사설 CA 신뢰는 lib/config/tls_bootstrap.dart 에서 처리한다.

  이 파일이 하는 일은 두 가지다.
  - cleartextTrafficPermitted: 평문 ws:// 개발 서버에 붙을 수 있게 한다.
  - user 신뢰 앵커: 네이티브 계층에서 나가는 트래픽이 사용자 설치 CA 를 신뢰한다.

  src/debug 소스셋에만 있으므로 릴리스 빌드에는 적용되지 않는다.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
